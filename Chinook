# The following queries are from a data base called chinook, used in SQL Lite studio.





#1. 
Extracting all USA based customer information using this first query.
  
SELECT customerid, firstname, lastname, country  FROM customers
WHERE country <> 'USA';


#2.
 This querty shows all customer information that is based in Brazil.
  
SELECT customerid, firstname, lastname, country
FROM customers
WHERE country = 'Brazil';



#3.
  This query involves pulling not only patient names, but invoice information from Brazil as well

SELECT firstname, lastname, invoiceid, invoicedate, billingcountry
FROM invoices
LEFT JOIN customers ON
    customers.customerid = invoices.CustomerId
    WHERE billingcountry = 'Brazil';
    


#4.
  The query here lets you see all Sales agents the store has.
SELECT lastname, firstname, title FROM employees
WHERE title = 'Sales Support Agent';


#5
  The results stated in this query let you see all of the countries from the invoice table.

SELECT DISTINCT billingcountry FROM invoices;


#6.
  First the query JOIN's the customers, employees, and invoices table, and then shows each Sales Agent's sales

SELECT e.firstname, e.lastname, invoiceid FROM employees e
INNER JOIN customers cust ON
    cust.supportrepid = e.employeeid
INNER JOIN invoices inv ON 
    inv.customerid = cust.customerid
    WHERE e.title = 'Sales Support Agent';
    



#7.
  I wanted this query to show the linked results of customers, country, total, and the employee that helped them.
  
SELECT i.total, cust.firstname, cust.lastname, i.billingcountry,
 em.firstname, em.lastname
FROM invoices i
JOIN customers cust ON 
    cust.customerid = i.customerid
JOIN employees em ON
    cust.supportrepid = em.employeeid;



#8.
  The query here is designed to show all transactions from 2009.

SELECT invoiceid, invoicedate FROM invoices
WHERE invoicedate LIKE '2009%';



#9.
  This query shows the sum total of each invoice.

SELECT SUM(total) FROM invoices 
WHERE invoicedate BETWEEN '2009-01-01' AND '2009-12-31';



